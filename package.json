{
  "name": "booksaga",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @booksaga/web dev",
    "worker:dev": "pnpm --filter @booksaga/worker dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:all": "vitest run",
    "test:e2e": "pnpm --filter @booksaga/web test:e2e",
    "format": "prettier --write .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "gen:types": "node scripts/gen-types.mjs",
    "env:local": "node scripts/setup-local-env.mjs",
    "create-admin": "tsx --env-file=.env.local scripts/create-admin.ts"
  },
  "devDependencies": {
    "@booksaga/core": "workspace:*",
    "@booksaga/shared": "workspace:*",
    "@eslint/js": "9.39.5",
    "@supabase/supabase-js": "2.118.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
