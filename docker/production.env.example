# Copy to .env.production at the repository root on the VPS and fill the placeholders.
APP_URL=http://localhost:8080
NODE_ENV=production
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_PRIVATE_SERVICE_ROLE_KEY
SUPABASE_DB_URL=
SETTINGS_ENCRYPTION_KEY=
REDIS_URL=redis://redis:6379

# Private preview before choosing a domain. Connect through the SSH tunnel in docs/LAUNCH.md.
CADDYFILE=./Caddyfile.preview
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
HTTPS_BIND=127.0.0.1
IMAGE_TAG=local

# Use mock while checking infrastructure. Set live and fill provider keys for the live smoke.
AI_MODE=mock
TEXT_API_BASE_URL=https://openrouter.ai/api/v1
TEXT_API_KEY=
TEXT_MODEL=deepseek/deepseek-v4.1-flash-1017
TEXT_FAST_MODEL=
TEXT_REASONING_EFFORT=low
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=openai/gpt-image-2
REPLICATE_IMAGE_QUALITY=low
REPLICATE_TTS_MODEL=jaaari/kokoro-82m
WORKER_QUEUES=text,image,export,audio,system
WORKER_TEXT_CONCURRENCY=50
WORKER_IMAGE_CONCURRENCY=5
WORKER_EXPORT_CONCURRENCY=2
WORKER_AUDIO_CONCURRENCY=3
WORKER_HEALTH_PORT=3001
TEXT_RPM=300
REPLICATE_RPM=120

# Fill before enabling the weekly backup timer. Use a PostgreSQL client matching the server.
BACKUP_DIR=/var/backups/booksaga
BACKUP_SSH_DEST=
