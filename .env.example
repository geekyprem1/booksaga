# ---- App ----
APP_URL=http://localhost:3000
NODE_ENV=development
# 32-byte base64, e.g. `openssl rand -base64 32`. Encrypts secrets stored in app_settings.
SETTINGS_ENCRYPTION_KEY=

# ---- Supabase (local values come from `supabase status`) ----
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct DB URL (used by DB tests only)
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- AI (M2+) ----
AI_MODE=live
# Text LLM: any OpenAI-compatible chat-completions endpoint. Default is OpenRouter.
# Examples: https://api.openai.com/v1 · https://api.deepseek.com/v1 · https://api.together.xyz/v1
#           https://api.groq.com/openai/v1 · http://localhost:11434/v1 (Ollama, key optional)
# The URL is the part before /chat/completions.
TEXT_API_BASE_URL=https://openrouter.ai/api/v1
TEXT_API_KEY=
TEXT_MODEL=deepseek/deepseek-v4.1-flash-1017
# Optional: cheaper/faster model for extract, continuity and metadata (defaults to the text model).
# Measured on OpenRouter: mistralai/mistral-small-3.2-24b-instruct (no reasoning, ~10s, $0.0003/call),
# z-ai/glm-5.3-flash (~24s, $0.00035/call).
TEXT_FAST_MODEL=
# Reasoning effort: low | medium | high (empty = provider default). Low cuts hidden reasoning tokens.
TEXT_REASONING_EFFORT=low
REPLICATE_API_TOKEN=
# Cover cost policy: GPT Image 2 and low quality are fixed; other values fail validation.
REPLICATE_IMAGE_MODEL=openai/gpt-image-2
REPLICATE_IMAGE_QUALITY=low
REPLICATE_TTS_MODEL=jaaari/kokoro-82m

# ---- Worker ----
WORKER_QUEUES=text,image,export,audio,system
WORKER_TEXT_CONCURRENCY=50
WORKER_IMAGE_CONCURRENCY=5
WORKER_EXPORT_CONCURRENCY=2
WORKER_AUDIO_CONCURRENCY=3
# /healthz endpoint for the worker
WORKER_HEALTH_PORT=3001
TEXT_RPM=300
REPLICATE_RPM=120
